# Production settings: copy to .env on the server and fill in. Never commit .env.

# Your domain, without https:// (Traefik routes it here and gets its certificate)
DOMAIN=chess.example.com
# The same, as the full public address: used in emailed links, Google sign-in, canonical URLs and the sitemap
APP_URL=https://chess.example.com

# Shown on the About, Privacy and Terms pages
CONTACT_EMAIL=hello@example.com

# Email (confirmations, password resets). Without SMTP_HOST, emails are only written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="3D Chess <no-reply@chess.example.com>"

# Sign in with Google (optional): OAuth client of type "Web application",
# authorized redirect URI: https://<DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google AdSense (optional): ads stay off until ADSENSE_CLIENT is set
ADSENSE_CLIENT=
ADSENSE_SLOT_MENU=
ADSENSE_SLOT_PAGE=
